# News API keys — used ONLY by scripts/draft-briefing.mjs to pre-fill a weekly
# draft. They are not read during the site render.
NEWSDATA_API_KEY=your_newsdata_api_key
NEWSAPI_ORG_KEY=your_newsapi_org_key

# Groq — writes the grounded "why it matters" takes and matches each story to
# an awareness guide. Without it the briefing still publishes, as a curated
# link list with no takes.
GROQ_API_KEY=your_groq_api_key
# Optional. Defaults to openai/gpt-oss-120b. Groq rotates its hosted models;
# if the default id is retired the drafter prints what your key can use.
GROQ_MODEL=

# Optional. Milliseconds between Groq calls (default 15000). The free tier
# meters tokens per minute; lower this only on a paid tier.
GROQ_PACING_MS=

# Contact form
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Optional: shows a direct "email us" block on /contact when set.
NEXT_PUBLIC_EDITOR_EMAIL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics is
# disabled entirely when this is unset.
NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_SITE_URL=https://cybervani.com
